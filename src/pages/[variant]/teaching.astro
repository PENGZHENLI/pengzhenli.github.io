---
import TeachingPage from '../../components/pages/TeachingPage.astro';
import { variants, subVariants } from '../../data/variants';
export function getStaticPaths() {
  return subVariants.map((variant) => ({ params: { variant } }));
}
const v = variants[Astro.params.variant as keyof typeof variants];
---
<TeachingPage variant={v} />
