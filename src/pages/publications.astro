---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publications } from '../data/publications';
import { profile } from '../data/profile';
---

<BaseLayout title="Publications — Pengzhen Li">
  <h2 class="text-xl font-semibold">Publications</h2>
  <p class="mt-2 text-sm text-neutral-600">
    Peer-reviewed, in reverse chronological order.
    {profile.googleScholar && (
      <>
        {" "}See also{" "}
        <a href={profile.googleScholar} target="_blank" rel="noopener">Google Scholar</a>.
      </>
    )}
  </p>

  <ol class="mt-6 space-y-5 list-none pl-0">
    {
      publications.map((p, i) => (
        <li class="flex gap-3">
          <span class="text-neutral-400 w-6 shrink-0 tabular-nums">[{i + 1}]</span>
          <div>
            <div class="font-medium">
              {p.url ? <a href={p.url}>{p.title}</a> : p.title}
            </div>
            <div class="text-sm text-neutral-600">{p.authors}</div>
            <div class="text-sm italic text-neutral-600">
              {p.journal}
              {p.volume ? `, ${p.volume}` : ""} ({p.year})
              {p.pages ? `, ${p.pages}` : ""}.
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</BaseLayout>
