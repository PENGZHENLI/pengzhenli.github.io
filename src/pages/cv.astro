---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout title={`CV — ${profile.name}`}>
  <h2 class="text-xl font-semibold">Curriculum Vitae</h2>
  <p class="mt-4">
    <a
      href={profile.cvFile}
      target="_blank"
      rel="noopener"
      class="inline-block border border-neutral-300 px-4 py-2 hover:bg-neutral-50"
    >
      Download PDF
    </a>
  </p>
  <div class="mt-8 hidden md:block" style="height: 85vh;">
    <iframe
      src={profile.cvFile}
      class="h-full w-full border border-neutral-200"
      title="CV PDF"
    ></iframe>
  </div>
</BaseLayout>
