---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import profilePhoto from '../assets/profile.jpg';
---

<BaseLayout title={`${profile.name} — ${profile.title}`}>
  <section class="flex flex-col sm:flex-row gap-6 sm:gap-8 items-center sm:items-start">
    <Image
      src={profilePhoto}
      alt={`Portrait of ${profile.name}`}
      width={320}
      height={320}
      class="w-32 h-32 sm:w-40 sm:h-40 rounded-full object-cover shrink-0 border border-neutral-200"
    />
    <div class="text-center sm:text-left">
      <p class="text-lg text-neutral-800">{profile.title}</p>
      <p class="text-neutral-600">{profile.affiliation}</p>
      <p class="text-neutral-600">{profile.university}</p>
      <p class="mt-3 text-sm flex flex-wrap justify-center sm:justify-start gap-x-4 gap-y-1">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        {profile.googleScholar && (
          <a href={profile.googleScholar} target="_blank" rel="noopener">Google Scholar</a>
        )}
        {profile.linkedin && (
          <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        )}
      </p>
    </div>
  </section>

  <section class="mt-10">
    <p class="text-neutral-800">{profile.bio}</p>
  </section>

  <section class="mt-8 text-sm flex flex-wrap gap-x-6 gap-y-2">
    <a href={profile.cvFile} target="_blank" rel="noopener">Download CV (PDF)</a>
    <a href="/publications">Publications</a>
    <a href="/working-papers">Working Papers</a>
  </section>
</BaseLayout>
