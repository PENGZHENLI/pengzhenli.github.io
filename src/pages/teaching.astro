---
import BaseLayout from '../layouts/BaseLayout.astro';
import { primaryInstructor, teachingAssistant } from '../data/teaching';
---

<BaseLayout title="Teaching — Pengzhen Li">
  <h2 class="text-xl font-semibold">Teaching</h2>

  <h3 class="text-lg font-semibold mt-8">Primary Instructor</h3>
  <ul class="mt-3 list-none pl-0">
    {
      primaryInstructor.map((c) => (
        <li class="flex justify-between gap-4 border-b border-neutral-100 py-2">
          <span>
            <span class="font-medium">{c.code}</span> — {c.title}
          </span>
          <span class="text-neutral-600 text-sm whitespace-nowrap">{c.term}</span>
        </li>
      ))
    }
  </ul>

  <h3 class="text-lg font-semibold mt-10">Teaching Assistant</h3>
  <ul class="mt-3 list-none pl-0">
    {
      teachingAssistant.map((c) => (
        <li class="flex justify-between gap-4 border-b border-neutral-100 py-2">
          <span>
            <span class="font-medium">{c.code}</span> — {c.title}
          </span>
          <span class="text-neutral-600 text-sm whitespace-nowrap">{c.term}</span>
        </li>
      ))
    }
  </ul>
</BaseLayout>
