---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { orderedPapers } from '../../data/papers';
import { profile } from '../../data/profile';
import type { Variant } from '../../data/variants';

interface Props { variant: Variant }
const { variant: v } = Astro.props;
const all = orderedPapers(v.paperOrder);
const working = all.filter((p) => !p.wip);
const wip = all.filter((p) => p.wip);
---

<BaseLayout title={`Working Papers — ${profile.name}`} variant={v}>
  <h2 class="text-xl font-semibold">Working Papers</h2>

  <ol class="mt-6 space-y-5 list-none pl-0">
    {working.map((p, i) => (
      <li class="flex gap-3">
        <span class="text-neutral-400 w-6 shrink-0 tabular-nums">[{i + 1}]</span>
        <div>
          <div class="font-medium">{p.url ? <a href={p.url}>{p.title}</a> : p.title}</div>
          <div class="text-sm text-neutral-600">{p.authors}</div>
          {p.note && <div class="text-sm italic text-neutral-600">{p.note}</div>}
          {v.showJmpAbstract && p.id === "jmp" && p.abstract && (
            <p class="mt-2 text-sm text-neutral-700"><span class="underline">Abstract</span>: {p.abstract}</p>
          )}
          {(p.url || p.slidesUrl) && (
            <div class="text-sm mt-1 space-x-3">
              {p.url && <a href={p.url}>{p.url.startsWith("http") ? "[ssrn]" : "[draft]"}</a>}
              {p.slidesUrl && <a href={p.slidesUrl}>[slides]</a>}
            </div>
          )}
        </div>
      </li>
    ))}
  </ol>

  {wip.length > 0 && (
    <>
      <h2 class="text-xl font-semibold mt-12">Work in Progress</h2>
      <ul class="mt-6 space-y-3 list-none pl-0">
        {wip.map((p) => (
          <li>
            <div class="font-medium">{p.title}</div>
            <div class="text-sm text-neutral-600">{p.authors}</div>
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>
