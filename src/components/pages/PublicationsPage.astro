---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { orderedPublications } from '../../data/publications';
import { profile } from '../../data/profile';
import type { Variant } from '../../data/variants';

interface Props { variant: Variant }
const { variant: v } = Astro.props;
const pubs = orderedPublications(v.pubOrder);
const chrono = v.pubOrder[0] === "bb";
---

<BaseLayout title={`Publications — ${profile.name}`} variant={v}>
  <h2 class="text-xl font-semibold">Publications</h2>
  <p class="mt-2 text-sm text-neutral-600">
    {v.showMetrics ? "Four peer-reviewed (SSCI/SCI-indexed) publications." : chrono ? "Peer-reviewed, in reverse chronological order." : "Peer-reviewed."}
    {profile.googleScholar && (<> {" "}See also <a href={profile.googleScholar} target="_blank" rel="noopener">Google Scholar</a>.</>)}
  </p>

  <ol class="mt-6 space-y-5 list-none pl-0">
    {pubs.map((p, i) => (
      <li class="flex gap-3">
        <span class="text-neutral-400 w-6 shrink-0 tabular-nums">[{i + 1}]</span>
        <div>
          <div class="font-medium">{p.url ? <a href={p.url}>{p.title}</a> : p.title}</div>
          <div class="text-sm text-neutral-600">
            {p.authors.split("Pengzhen Li").flatMap((part, k) => (k === 0 ? [part] : [<span class="font-medium text-neutral-900">Pengzhen Li</span>, part]))}
          </div>
          <div class="text-sm italic text-neutral-600">
            {p.journal}{p.volume ? `, ${p.volume}` : ""} ({p.year}){p.pages ? `, ${p.pages}` : ""}.
          </div>
          {v.showMetrics && p.metrics && <div class="text-sm font-medium text-neutral-800">{p.metrics}</div>}
          {(p.doi || p.code) && (
            <div class="text-sm mt-1 space-x-3">
              {p.doi && <a href={p.doi} target="_blank" rel="noopener">[doi]</a>}
              {p.code && <a href={p.code} target="_blank" rel="noopener">[code &amp; data]</a>}
            </div>
          )}
        </div>
      </li>
    ))}
  </ol>
</BaseLayout>
