---
import type { Variant } from "../data/variants";

interface Props { variant: Variant }
const { variant } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const base = variant.basePath;
const home = base === "" ? "/" : base;

const links = [
  { href: home, label: "Home" },
  { href: `${base}/cv`, label: variant.navLabels?.cv ?? "CV" },
  { href: `${base}/publications`, label: "Publications" },
  { href: `${base}/working-papers`, label: "Working Papers" },
  { href: `${base}/research`, label: variant.navLabels?.research ?? "Research" },
  { href: `${base}/teaching`, label: "Teaching" },
];

const isActive = (h: string) =>
  h === home ? pathname === home : pathname === h || pathname.startsWith(h + "/");
---

<header class="border-b border-neutral-200 pb-4">
  <a href={home}>
    <h1 class="text-2xl font-semibold text-neutral-900">{variant.displayName}</h1>
  </a>
  <nav class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
    {links.map((l) => (
      <a href={l.href} class={isActive(l.href) ? "text-neutral-900 font-medium" : "text-neutral-600 hover:text-neutral-900"}>
        {l.label}
      </a>
    ))}
  </nav>
</header>
