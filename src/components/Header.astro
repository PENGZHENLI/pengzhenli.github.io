---
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Home" },
  { href: "/cv", label: "CV" },
  { href: "/publications", label: "Publications" },
  { href: "/working-papers", label: "Working Papers" },
  { href: "/research", label: "Research" },
  { href: "/teaching", label: "Teaching" },
];

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(href + "/");
---

<header class="border-b border-neutral-200 pb-4">
  <a href="/">
    <h1 class="text-2xl font-semibold text-neutral-900">Pengzhen Li</h1>
  </a>
  <nav class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
    {
      links.map((l) => (
        <a
          href={l.href}
          class={
            isActive(l.href)
              ? "text-neutral-900 font-medium"
              : "text-neutral-600 hover:text-neutral-900"
          }
        >
          {l.label}
        </a>
      ))
    }
  </nav>
</header>
